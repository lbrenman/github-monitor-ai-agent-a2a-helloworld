# ── Required ──────────────────────────────────────────────────────────────────

# Anthropic API key — https://console.anthropic.com
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# GitHub Personal Access Token (classic)
# Scopes needed: repo, read:user
# Create at: https://github.com/settings/tokens
GITHUB_TOKEN=your_github_token_here

# Comma-separated list of repos to monitor for branch/commit activity.
# Each entry can be "repo-name" (owner assumed to be GITHUB_USER) or
# "owner/repo-name" for repos you don't own.
# Example: fhir-codespace,Sonos-Vibe-Coded-Loopstation,someorg/some-repo
GITHUB_REPOS=your-repo-one,your-repo-two

# Public URL of the slack-notifier-agent Codespace
# Find this in the Ports tab of the notifier Codespace (port 3100, set to Public)
# Example: https://leor-laughing-spoon-abc123-3100.app.github.dev
NOTIFIER_URL=https://YOUR-CODESPACE-NAME-3100.app.github.dev

# API key for the notifier, if it has API_KEY set in its own .env.
# Must match the notifier's API_KEY exactly. Leave unset if the notifier
# is running in unauthenticated dev mode.
# NOTIFIER_API_KEY=your-shared-secret-here

# ── Optional ──────────────────────────────────────────────────────────────────

# GitHub username to monitor (default: lbrenman)
# GITHUB_USER=lbrenman

# Poll interval in milliseconds (default: 60000)
# POLL_INTERVAL_MS=60000

# Claude model
# MODEL=claude-opus-4-5-20251101
